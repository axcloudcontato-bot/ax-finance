# Copie para `.env` (mesmo diretório do docker-compose.yml) antes de rodar
# `docker compose up`. O Compose lê esse `.env` automaticamente.

# Senha do superusuário do Postgres (dono das tabelas, usado só pelo job de
# migrations). Gere uma senha forte por ambiente.
POSTGRES_PASSWORD=troque-este-valor

# Senha do role de baixo privilégio `ax_app`, o que a aplicação usa em
# runtime. A migration `20260925015200_rls_and_app_role` cria esse role com a
# senha de desenvolvimento "OMe21B_Wkcck4aQcsck8NQ_3" caso ele ainda não
# exista — em produção, depois do primeiro `docker compose up`, troque-a:
#   docker compose exec postgres psql -U postgres -d ax_finance \
#     -c "ALTER ROLE ax_app WITH PASSWORD 'novo-valor-forte'"
# e atualize esta variável para o mesmo valor antes de reiniciar o `web`.
AX_APP_PASSWORD=OMe21B_Wkcck4aQcsck8NQ_3

# Segredo para assinar o cookie de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-este-valor

# Chave separada usada para cifrar os segredos dos autenticadores TOTP.
# Gere com o mesmo comando acima e mantenha estável entre os deploys.
MFA_ENCRYPTION_KEY=troque-este-valor

# URL pública e SMTP para confirmação de e-mail/recuperação de senha.
APP_BASE_URL=https://financeiro.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-smtp
SMTP_PASSWORD=troque-este-valor
SMTP_FROM="AX Finance <no-reply@example.com>"
