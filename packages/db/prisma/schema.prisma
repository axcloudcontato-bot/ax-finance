// Schema do AX Finance.
// Fundação: identidade, isolamento multiempresa e contas financeiras (FIN-001, FIN-002).
// Núcleo financeiro: categorias, títulos, baixas, transferências, clientes/fornecedores,
// parcelamento, recorrências, conciliação bancária, trilha de auditoria, fechamento de
// período e ajuste manual de saldo (Seções 5-13, 17-19 do DIRECAO.md).
// Assinatura já mantém ciclo local e notificações; checkout, PSP e webhooks ainda não existem.
// Anexos privados, recuperação de senha, verificação de e-mail, limitação de tentativas,
// MFA e outbox/worker já fazem parte do núcleo.
// Convites/revogação e permissões por papel já são aplicados no domínio; ver limitações e
// próximos passos em "Estado atual e limitações conhecidas" no README.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AccountTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum OutboxEventType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  DUE_DATE_SUMMARY
  WEEKLY_SUMMARY
  COMPANY_INVITATION
  ACCESS_CHANGED
  IMPORT_FAILED
  BILLING_NOTICE
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  DEAD_LETTER
}

enum ScheduledJobType {
  GENERATE_RECURRENCES
  DUE_NOTIFICATIONS
  WEEKLY_SUMMARY
  SUBSCRIPTION_NOTIFICATIONS
}

enum NotificationType {
  TITLE_DUE_TODAY
  TITLE_DUE_SOON
  TITLE_OVERDUE
  WEEKLY_SUMMARY
  IMPORT_COMPLETED
  IMPORT_FAILED
  INVITATION_ACCEPTED
  ACCESS_ROLE_CHANGED
  BILLING_TRIAL_ENDING
  BILLING_TRIAL_ENDED
  BILLING_PAYMENT_DUE
  BILLING_PAYMENT_FAILED
  BILLING_GRACE_PERIOD
  BILLING_CANCELLATION_SCHEDULED
  BILLING_CANCELLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAYMENT_PENDING
  GRACE_PERIOD
  SUSPENDED
  CANCELLATION_SCHEDULED
  CANCELLED
}

enum MembershipRole {
  OWNER
  FINANCE_ADMIN
  OPERATOR
  ACCOUNTANT
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

enum MembershipAccessScope {
  ALL
  RESTRICTED
}

enum CompanyInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum CompanyStatus {
  ACTIVE
  ARCHIVED
}

enum AccountType {
  BANK
  CASH
  WALLET
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id                    String     @id @default(uuid())
  email                 String     @unique
  emailVerifiedAt       DateTime?  @map("email_verified_at")
  passwordHash          String     @map("password_hash")
  name                  String
  status                UserStatus @default(ACTIVE)
  mfaSecretEncrypted    String?    @map("mfa_secret_encrypted")
  mfaEnabledAt          DateTime?  @map("mfa_enabled_at")
  mfaRecoveryCodeHashes Json?      @map("mfa_recovery_code_hashes")
  mfaLastUsedCounter    BigInt?    @map("mfa_last_used_counter")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  sessions                Session[]
  memberships             Membership[]
  invitationsCreated      CompanyInvitation[]      @relation("InvitationCreator")
  accountTokens           AccountToken[]
  mfaSetup                MfaSetup?
  mfaChallenges           MfaChallenge[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  attachmentsUploaded     Attachment[]             @relation("AttachmentUploader")
  scheduledJobs           ScheduledJob[]           @relation("ScheduledJobRunner")
  importBatchesRequested  ImportBatch[]            @relation("ImportBatchRequester")
  importJobsRun           ImportJob[]              @relation("ImportJobRunner")

  @@map("users")
}

model MfaSetup {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted String   @map("secret_encrypted")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("mfa_setups")
}

model MfaChallenge {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique @map("token_hash")
  rememberSession Boolean   @default(false) @map("remember_session")
  failedAttempts  Int       @default(0) @map("failed_attempts")
  expiresAt       DateTime  @map("expires_at")
  consumedAt      DateTime? @map("consumed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([userId, consumedAt])
  @@map("mfa_challenges")
}

model AccountToken {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AccountTokenType
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at")
  usedAt    DateTime?        @map("used_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, type, usedAt])
  @@map("account_tokens")
}

model LoginRateLimit {
  keyHash         String    @id @map("key_hash")
  failedAttempts  Int       @default(0) @map("failed_attempts")
  windowStartedAt DateTime  @default(now()) @map("window_started_at")
  blockedUntil    DateTime? @map("blocked_until")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("login_rate_limits")
}

model OutboxEvent {
  id               String            @id @default(uuid())
  type             OutboxEventType
  status           OutboxEventStatus @default(PENDING)
  dedupKey         String            @unique @map("dedup_key")
  payloadEncrypted String            @map("payload_encrypted")
  attempts         Int               @default(0)
  availableAt      DateTime          @default(now()) @map("available_at")
  lockedAt         DateTime?         @map("locked_at")
  lockedBy         String?           @map("locked_by")
  processedAt      DateTime?         @map("processed_at")
  lastError        String?           @map("last_error")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([status, availableAt, createdAt])
  @@map("outbox_events")
}

model ScheduledJob {
  id              String           @id @default(uuid())
  jobKey          String           @unique @map("job_key")
  type            ScheduledJobType
  companyId       String           @map("company_id")
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runAsUserId     String           @map("run_as_user_id")
  runAsUser       User             @relation("ScheduledJobRunner", fields: [runAsUserId], references: [id], onDelete: Cascade)
  nextRunAt       DateTime         @map("next_run_at")
  lockedAt        DateTime?        @map("locked_at")
  lockedBy        String?          @map("locked_by")
  lastCompletedAt DateTime?        @map("last_completed_at")
  lastError       String?          @map("last_error")
  attempts        Int              @default(0)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([nextRunAt])
  @@index([companyId])
  @@map("scheduled_jobs")
}

model Notification {
  id        String           @id @default(uuid())
  companyId String           @map("company_id")
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  dedupKey  String           @unique @map("dedup_key")
  title     String
  body      String
  href      String
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, companyId, readAt, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inAppDue     Boolean  @default(true) @map("in_app_due")
  emailDue     Boolean  @default(true) @map("email_due")
  inAppWeekly  Boolean  @default(true) @map("in_app_weekly")
  emailWeekly  Boolean  @default(true) @map("email_weekly")
  dueDaysAhead Int      @default(0) @map("due_days_ahead")
  deliveryHour Int      @default(8) @map("delivery_hour")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("notification_preferences")
}

model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@map("sessions")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  companies Company[]

  @@map("tenants")
}

model Company {
  id        String        @id @default(uuid())
  tenantId  String        @map("tenant_id")
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  document  String?
  currency  String        @default("BRL")
  timezone  String        @default("America/Sao_Paulo")
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  memberships             Membership[]
  financialAccounts       FinancialAccount[]
  costCenters             CostCenter[]
  categories              Category[]
  parties                 Party[]
  titles                  Title[]
  settlements             Settlement[]
  settlementRefunds       SettlementRefund[]
  titleAllocations        TitleAllocation[]
  transfers               Transfer[]
  recurrenceRules         RecurrenceRule[]
  importBatches           ImportBatch[]
  bankStatementLines      BankStatementLine[]
  auditEvents             AuditEvent[]
  periodClosures          PeriodClosure[]
  balanceAdjustments      BalanceAdjustment[]
  invitations             CompanyInvitation[]
  idempotencyRecords      IdempotencyRecord[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  attachments             Attachment[]
  scheduledJobs           ScheduledJob[]
  importJobs              ImportJob[]
  subscription            Subscription?

  @@index([tenantId])
  @@map("companies")
}

model Subscription {
  id                      String             @id @default(uuid())
  companyId               String             @unique @map("company_id")
  company                 Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status                  SubscriptionStatus @default(TRIAL)
  planCode                String             @default("TRIAL") @map("plan_code")
  trialEndsAt             DateTime?          @map("trial_ends_at")
  currentPeriodEnd        DateTime?          @map("current_period_end")
  graceEndsAt             DateTime?          @map("grace_ends_at")
  cancellationEffectiveAt DateTime?          @map("cancellation_effective_at")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@map("subscriptions")
}

model IdempotencyRecord {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  operation    String
  key          String
  requestHash  String   @map("request_hash")
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([companyId, operation, key])
  @@index([companyId, createdAt])
  @@map("idempotency_records")
}

model Membership {
  id          String                @id @default(uuid())
  userId      String                @map("user_id")
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String                @map("company_id")
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role        MembershipRole
  status      MembershipStatus      @default(ACTIVE)
  accessScope MembershipAccessScope @default(ALL) @map("access_scope")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  accountAccess    MembershipFinancialAccount[]
  costCenterAccess MembershipCostCenter[]

  @@unique([userId, companyId])
  @@unique([id, companyId])
  @@index([companyId])
  @@map("memberships")
}

model CompanyInvitation {
  id              String                  @id @default(uuid())
  companyId       String                  @map("company_id")
  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyName     String                  @map("company_name")
  email           String
  role            MembershipRole
  tokenHash       String                  @unique @map("token_hash")
  status          CompanyInvitationStatus @default(PENDING)
  invitedByUserId String                  @map("invited_by_user_id")
  invitedBy       User                    @relation("InvitationCreator", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  expiresAt       DateTime                @map("expires_at")
  acceptedAt      DateTime?               @map("accepted_at")
  revokedAt       DateTime?               @map("revoked_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  @@unique([companyId, email])
  @@index([companyId, status])
  @@map("company_invitations")
}

model FinancialAccount {
  id                       String        @id @default(uuid())
  companyId                String        @map("company_id")
  company                  Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name                     String
  type                     AccountType
  currency                 String        @default("BRL")
  openingBalanceCents      BigInt        @map("opening_balance_cents")
  openingDate              DateTime      @map("opening_date") @db.Date
  includedInAvailableTotal Boolean       @default(true) @map("included_in_available_total")
  status                   AccountStatus @default(ACTIVE)
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")

  settlements        Settlement[]
  settlementRefunds  SettlementRefund[]
  transfersFrom      Transfer[]                   @relation("TransferFromAccount")
  transfersTo        Transfer[]                   @relation("TransferToAccount")
  importBatches      ImportBatch[]
  bankStatementLines BankStatementLine[]
  balanceAdjustments BalanceAdjustment[]
  membershipAccess   MembershipFinancialAccount[]

  @@unique([id, companyId])
  @@index([companyId])
  @@map("financial_accounts")
}

enum CostCenterStatus {
  ACTIVE
  ARCHIVED
}

model CostCenter {
  id        String           @id @default(uuid())
  companyId String           @map("company_id")
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name      String
  code      String?
  status    CostCenterStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  titles           Title[]
  titleAllocations TitleAllocation[]
  recurrenceRules  RecurrenceRule[]
  membershipAccess MembershipCostCenter[]

  @@unique([id, companyId])
  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("cost_centers")
}

model MembershipFinancialAccount {
  companyId          String           @map("company_id")
  membershipId       String           @map("membership_id")
  membership         Membership       @relation(fields: [membershipId, companyId], references: [id, companyId], onDelete: Cascade)
  financialAccountId String           @map("financial_account_id")
  financialAccount   FinancialAccount @relation(fields: [financialAccountId, companyId], references: [id, companyId], onDelete: Cascade)
  createdAt          DateTime         @default(now()) @map("created_at")

  @@id([membershipId, financialAccountId])
  @@index([financialAccountId])
  @@map("membership_financial_accounts")
}

model MembershipCostCenter {
  companyId    String     @map("company_id")
  membershipId String     @map("membership_id")
  membership   Membership @relation(fields: [membershipId, companyId], references: [id, companyId], onDelete: Cascade)
  costCenterId String     @map("cost_center_id")
  costCenter   CostCenter @relation(fields: [costCenterId, companyId], references: [id, companyId], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([membershipId, costCenterId])
  @@index([costCenterId])
  @@map("membership_cost_centers")
}

// Correção manual de saldo (ex.: divergência com o extrato real) — não é uma
// baixa nem transferência, é um ajuste direto no saldo da conta. Guarda o
// delta (amountCents, pode ser negativo) já calculado a partir do saldo alvo
// informado pelo usuário; o cálculo em si (saldo alvo − saldo atual) fica no
// domínio, não na UI. Reversível como settlement/transfer (nunca apaga).
model BalanceAdjustment {
  id                 String           @id @default(uuid())
  companyId          String           @map("company_id")
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  financialAccountId String           @map("financial_account_id")
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  amountCents        BigInt           @map("amount_cents")
  reason             String
  effectiveDate      DateTime         @map("effective_date") @db.Date
  createdByUserId    String           @map("created_by_user_id")
  reversedAt         DateTime?        @map("reversed_at")
  reversalReason     String?          @map("reversal_reason")
  createdAt          DateTime         @default(now()) @map("created_at")

  @@index([companyId])
  @@index([financialAccountId])
  @@map("balance_adjustments")
}

enum CategoryNature {
  OPERATING_REVENUE
  COST
  EXPENSE
  INVESTMENT
  FINANCING
  EQUITY
  TECHNICAL_TRANSFER
}

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

model Category {
  id              String         @id @default(uuid())
  companyId       String         @map("company_id")
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parentId        String?        @map("parent_id")
  parent          Category?      @relation("CategoryParent", fields: [parentId], references: [id], onDelete: Restrict)
  children        Category[]     @relation("CategoryParent")
  name            String
  nature          CategoryNature
  managerialGroup String?        @map("managerial_group")
  order           Int            @default(0)
  color           String?
  status          CategoryStatus @default(ACTIVE)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  titles          Title[]
  titleAllocations TitleAllocation[]
  recurrenceRules RecurrenceRule[]

  @@unique([id, companyId])
  @@index([companyId])
  @@index([parentId])
  @@map("categories")
}

enum PartyStatus {
  ACTIVE
  INACTIVE
}

model Party {
  id                 String      @id @default(uuid())
  companyId          String      @map("company_id")
  company            Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name               String
  tradeName          String?     @map("trade_name")
  document           String?
  documentNormalized String?     @map("document_normalized")
  email              String?
  phone              String?
  address            String?
  responsibleName    String?     @map("responsible_name")
  notes              String?
  isClient           Boolean     @default(false) @map("is_client")
  isSupplier         Boolean     @default(false) @map("is_supplier")
  status             PartyStatus @default(ACTIVE)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  titles          Title[]
  recurrenceRules RecurrenceRule[]

  @@unique([id, companyId])
  @@index([companyId])
  @@map("parties")
}

enum TitleType {
  RECEIVABLE
  PAYABLE
}

enum TitleStatus {
  OPEN
  PARTIALLY_SETTLED
  SETTLED
  CANCELLED
}

enum RecurrenceStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model RecurrenceRule {
  id           String           @id @default(uuid())
  companyId    String           @map("company_id")
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  type         TitleType
  description  String
  categoryId   String           @map("category_id")
  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  partyId      String?          @map("party_id")
  party        Party?           @relation(fields: [partyId], references: [id], onDelete: Restrict)
  costCenterId String?          @map("cost_center_id")
  costCenter   CostCenter?      @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  amountCents  BigInt           @map("amount_cents")
  dayOfMonth   Int              @map("day_of_month")
  startDate    DateTime         @map("start_date") @db.Date
  endDate      DateTime?        @map("end_date") @db.Date
  status       RecurrenceStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  titles Title[]

  @@unique([id, companyId])
  @@index([companyId])
  @@map("recurrence_rules")
}

model Title {
  id                       String          @id @default(uuid())
  companyId                String          @map("company_id")
  company                  Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  type                     TitleType
  description              String
  categoryId               String          @map("category_id")
  category                 Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  partyId                  String?         @map("party_id")
  party                    Party?          @relation(fields: [partyId], references: [id], onDelete: Restrict)
  costCenterId             String?         @map("cost_center_id")
  costCenter               CostCenter?     @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  originalAmountCents      BigInt          @map("original_amount_cents")
  currency                 String          @default("BRL")
  competenceDate           DateTime        @map("competence_date") @db.Date
  dueDate                  DateTime        @map("due_date") @db.Date
  status                   TitleStatus     @default(OPEN)
  cancelReason             String?         @map("cancel_reason")
  notes                    String?
  installmentGroupId       String?         @map("installment_group_id")
  installmentNumber        Int?            @map("installment_number")
  installmentCount         Int?            @map("installment_count")
  recurrenceRuleId         String?         @map("recurrence_rule_id")
  recurrenceRule           RecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id], onDelete: Restrict)
  recurrenceOccurrenceDate DateTime?       @map("recurrence_occurrence_date") @db.Date
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")
  deletedAt                DateTime?       @map("deleted_at")
  deletedByUserId          String?         @map("deleted_by_user_id")
  deleteReason             String?         @map("delete_reason")

  settlements Settlement[]
  allocations TitleAllocation[]
  attachments Attachment[]

  @@unique([id, companyId])
  @@unique([recurrenceRuleId, recurrenceOccurrenceDate])
  @@index([companyId])
  @@index([companyId, dueDate])
  @@index([categoryId])
  @@index([partyId])
  @@index([companyId, installmentGroupId])
  @@index([companyId, recurrenceRuleId])
  @@map("titles")
}

model Attachment {
  id               String               @id @default(uuid())
  companyId        String               @map("company_id")
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  titleId          String               @map("title_id")
  title            Title                @relation(fields: [titleId], references: [id], onDelete: Cascade)
  uploadedByUserId String               @map("uploaded_by_user_id")
  uploadedBy       User                 @relation("AttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  originalName     String               @map("original_name")
  mimeType         String               @map("mime_type")
  sizeBytes        Int                  @map("size_bytes")
  sha256           String
  storageKey       String               @unique @map("storage_key")
  storageBackend   String               @default("LOCAL") @map("storage_backend")
  scanStatus       AttachmentScanStatus @default(NOT_SCANNED) @map("scan_status")
  scannedAt        DateTime?            @map("scanned_at")
  createdAt        DateTime             @default(now()) @map("created_at")

  @@index([companyId, titleId, createdAt])
  @@map("attachments")
}

enum AttachmentScanStatus {
  NOT_SCANNED
  CLEAN
  INFECTED
  ERROR
}

model Settlement {
  id                   String           @id @default(uuid())
  companyId            String           @map("company_id")
  company              Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  titleId              String           @map("title_id")
  title                Title            @relation(fields: [titleId], references: [id], onDelete: Restrict)
  financialAccountId   String           @map("financial_account_id")
  financialAccount     FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  principalAmountCents BigInt           @map("principal_amount_cents")
  discountCents        BigInt           @default(0) @map("discount_cents")
  interestPenaltyCents BigInt           @default(0) @map("interest_penalty_cents")
  feesCents            BigInt           @default(0) @map("fees_cents")
  effectiveDate        DateTime         @map("effective_date") @db.Date
  paymentMethod        String?          @map("payment_method")
  notes                String?
  reversedAt           DateTime?        @map("reversed_at")
  reversalReason       String?          @map("reversal_reason")
  createdAt            DateTime         @default(now()) @map("created_at")

  reconciledByLine BankStatementLine?
  refunds         SettlementRefund[]

  @@unique([id, companyId])
  @@index([companyId])
  @@index([titleId])
  @@map("settlements")
}

/// Devolução/reembolso de uma baixa. Preserva a baixa original e registra o
/// movimento de caixa oposto, podendo ser estornado sem apagar histórico.
model SettlementRefund {
  id                 String           @id @default(uuid())
  companyId          String           @map("company_id")
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  settlementId       String           @map("settlement_id")
  settlement         Settlement       @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  financialAccountId String           @map("financial_account_id")
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  amountCents        BigInt           @map("amount_cents")
  effectiveDate      DateTime         @map("effective_date") @db.Date
  reason             String
  createdByUserId    String           @map("created_by_user_id")
  reversedAt         DateTime?        @map("reversed_at")
  reversalReason     String?          @map("reversal_reason")
  createdAt          DateTime         @default(now()) @map("created_at")

  @@unique([id, companyId])
  @@index([companyId])
  @@index([settlementId])
  @@index([financialAccountId])
  @@map("settlement_refunds")
}

/// Rateio gerencial explícito. Quando existem linhas, a soma deve ser igual
/// ao valor original do título; categoria/centro no título seguem como padrão.
model TitleAllocation {
  id           String      @id @default(uuid())
  companyId    String      @map("company_id")
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  titleId      String      @map("title_id")
  title        Title       @relation(fields: [titleId], references: [id], onDelete: Cascade)
  categoryId   String      @map("category_id")
  category     Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  costCenterId String?     @map("cost_center_id")
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  amountCents  BigInt      @map("amount_cents")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@unique([id, companyId])
  @@index([companyId, titleId])
  @@index([categoryId])
  @@index([costCenterId])
  @@map("title_allocations")
}

model Transfer {
  id             String           @id @default(uuid())
  companyId      String           @map("company_id")
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  fromAccountId  String           @map("from_account_id")
  fromAccount    FinancialAccount @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccountId    String           @map("to_account_id")
  toAccount      FinancialAccount @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  amountCents    BigInt           @map("amount_cents")
  feeCents       BigInt           @default(0) @map("fee_cents")
  transferDate   DateTime         @map("transfer_date") @db.Date
  description    String?
  reversedAt     DateTime?        @map("reversed_at")
  reversalReason String?          @map("reversal_reason")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([companyId])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("transfers")
}

enum BankStatementLineStatus {
  PENDING
  RECONCILED
  IGNORED
}

enum ImportFileFormat {
  CSV
  OFX
}

enum ImportBatchStatus {
  PREVIEW
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ImportBatch {
  id                 String            @id @default(uuid())
  companyId          String            @map("company_id")
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  financialAccountId String            @map("financial_account_id")
  financialAccount   FinancialAccount  @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  fileName           String            @map("file_name")
  fileFormat         ImportFileFormat  @default(CSV) @map("file_format")
  status             ImportBatchStatus @default(COMPLETED)
  fileSizeBytes      Int               @default(0) @map("file_size_bytes")
  storageKey         String?           @unique @map("storage_key")
  columnMapping      Json?             @map("column_mapping")
  requestedByUserId  String?           @map("requested_by_user_id")
  requestedByUser    User?             @relation("ImportBatchRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  rowCount           Int               @default(0) @map("row_count")
  importedCount      Int               @default(0) @map("imported_count")
  duplicateCount     Int               @default(0) @map("duplicate_count")
  invalidCount       Int               @default(0) @map("invalid_count")
  startedAt          DateTime?         @map("started_at")
  completedAt        DateTime?         @map("completed_at")
  failureCode        String?           @map("failure_code")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  lines BankStatementLine[]
  job   ImportJob?

  @@unique([id, companyId])
  @@index([companyId])
  @@index([companyId, status, createdAt])
  @@map("import_batches")
}

model ImportJob {
  id            String          @id @default(uuid())
  importBatchId String          @unique @map("import_batch_id")
  importBatch   ImportBatch     @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  companyId     String          @map("company_id")
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runAsUserId   String          @map("run_as_user_id")
  runAsUser     User            @relation("ImportJobRunner", fields: [runAsUserId], references: [id], onDelete: Cascade)
  status        ImportJobStatus @default(PENDING)
  attempts      Int             @default(0)
  availableAt   DateTime        @default(now()) @map("available_at")
  lockedAt      DateTime?       @map("locked_at")
  lockedBy      String?         @map("locked_by")
  lastError     String?         @map("last_error")
  completedAt   DateTime?       @map("completed_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([status, availableAt, createdAt])
  @@index([companyId])
  @@map("import_jobs")
}

model BankStatementLine {
  id                     String                  @id @default(uuid())
  companyId              String                  @map("company_id")
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  financialAccountId     String                  @map("financial_account_id")
  financialAccount       FinancialAccount        @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  importBatchId          String                  @map("import_batch_id")
  importBatch            ImportBatch             @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  lineDate               DateTime                @map("line_date") @db.Date
  description            String
  amountCents            BigInt                  @map("amount_cents")
  dedupKey               String                  @map("dedup_key")
  status                 BankStatementLineStatus @default(PENDING)
  reconciledSettlementId String?                 @unique @map("reconciled_settlement_id")
  reconciledSettlement   Settlement?             @relation(fields: [reconciledSettlementId], references: [id], onDelete: Restrict)
  ignoreReason           String?                 @map("ignore_reason")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@unique([companyId, financialAccountId, dedupKey])
  @@index([companyId])
  @@index([financialAccountId])
  @@map("bank_statement_lines")
}

model AuditEvent {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actorUserId  String   @map("actor_user_id")
  eventType    String   @map("event_type")
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  summary      String
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([companyId, resourceType, resourceId])
  @@index([companyId, createdAt])
  @@map("audit_events")
}

enum PeriodClosureStatus {
  CLOSED
  REOPENED
}

model PeriodClosure {
  id               String              @id @default(uuid())
  companyId        String              @map("company_id")
  company          Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  period           String
  status           PeriodClosureStatus @default(CLOSED)
  closedByUserId   String              @map("closed_by_user_id")
  closedAt         DateTime            @default(now()) @map("closed_at")
  reopenedByUserId String?             @map("reopened_by_user_id")
  reopenedAt       DateTime?           @map("reopened_at")
  reopenReason     String?             @map("reopen_reason")

  @@unique([companyId, period])
  @@map("period_closures")
}
