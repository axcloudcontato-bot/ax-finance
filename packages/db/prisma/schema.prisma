// Schema do AX Finance.
// Fundação: identidade, isolamento multiempresa e contas financeiras (FIN-001, FIN-002).
// Núcleo financeiro: categorias, títulos e baixas (Seções 6/7/9/18 do DIRECAO.md).
// Razão auxiliar, clientes/fornecedores, parcelamento e conciliação ainda não existem.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipRole {
  OWNER
  FINANCE_ADMIN
  OPERATOR
  ACCOUNTANT
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

enum CompanyStatus {
  ACTIVE
  ARCHIVED
}

enum AccountType {
  BANK
  CASH
  WALLET
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions    Session[]
  memberships Membership[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([userId])
  @@map("sessions")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  companies Company[]

  @@map("tenants")
}

model Company {
  id        String        @id @default(uuid())
  tenantId  String        @map("tenant_id")
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  document  String?
  currency  String        @default("BRL")
  timezone  String        @default("America/Sao_Paulo")
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  memberships       Membership[]
  financialAccounts FinancialAccount[]
  categories        Category[]
  parties           Party[]
  titles            Title[]
  settlements       Settlement[]
  transfers         Transfer[]
  recurrenceRules   RecurrenceRule[]
  importBatches       ImportBatch[]
  bankStatementLines  BankStatementLine[]
  auditEvents         AuditEvent[]
  periodClosures      PeriodClosure[]

  @@index([tenantId])
  @@map("companies")
}

model Membership {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String           @map("company_id")
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      MembershipRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("memberships")
}

model FinancialAccount {
  id                       String        @id @default(uuid())
  companyId                String        @map("company_id")
  company                  Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name                     String
  type                     AccountType
  currency                 String        @default("BRL")
  openingBalanceCents      BigInt        @map("opening_balance_cents")
  openingDate              DateTime      @map("opening_date") @db.Date
  includedInAvailableTotal Boolean       @default(true) @map("included_in_available_total")
  status                   AccountStatus @default(ACTIVE)
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")

  settlements     Settlement[]
  transfersFrom   Transfer[]   @relation("TransferFromAccount")
  transfersTo     Transfer[]   @relation("TransferToAccount")
  importBatches       ImportBatch[]
  bankStatementLines  BankStatementLine[]

  @@index([companyId])
  @@map("financial_accounts")
}

enum CategoryNature {
  OPERATING_REVENUE
  COST
  EXPENSE
  INVESTMENT
  FINANCING
  EQUITY
  TECHNICAL_TRANSFER
}

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

model Category {
  id              String         @id @default(uuid())
  companyId       String         @map("company_id")
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parentId        String?        @map("parent_id")
  parent          Category?      @relation("CategoryParent", fields: [parentId], references: [id], onDelete: Restrict)
  children        Category[]     @relation("CategoryParent")
  name            String
  nature          CategoryNature
  managerialGroup String?        @map("managerial_group")
  order           Int            @default(0)
  color           String?
  status          CategoryStatus @default(ACTIVE)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  titles          Title[]
  recurrenceRules RecurrenceRule[]

  @@index([companyId])
  @@index([parentId])
  @@map("categories")
}

enum PartyStatus {
  ACTIVE
  INACTIVE
}

model Party {
  id                 String      @id @default(uuid())
  companyId          String      @map("company_id")
  company            Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name               String
  tradeName          String?     @map("trade_name")
  document           String?
  documentNormalized String?     @map("document_normalized")
  email              String?
  phone              String?
  address            String?
  responsibleName    String?     @map("responsible_name")
  notes              String?
  isClient           Boolean     @default(false) @map("is_client")
  isSupplier         Boolean     @default(false) @map("is_supplier")
  status             PartyStatus @default(ACTIVE)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  titles          Title[]
  recurrenceRules RecurrenceRule[]

  @@index([companyId])
  @@map("parties")
}

enum TitleType {
  RECEIVABLE
  PAYABLE
}

enum TitleStatus {
  OPEN
  PARTIALLY_SETTLED
  SETTLED
  CANCELLED
}

enum RecurrenceStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model RecurrenceRule {
  id           String           @id @default(uuid())
  companyId    String           @map("company_id")
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  type         TitleType
  description  String
  categoryId   String           @map("category_id")
  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  partyId      String?          @map("party_id")
  party        Party?           @relation(fields: [partyId], references: [id], onDelete: Restrict)
  amountCents  BigInt           @map("amount_cents")
  dayOfMonth   Int              @map("day_of_month")
  startDate    DateTime         @map("start_date") @db.Date
  endDate      DateTime?        @map("end_date") @db.Date
  status       RecurrenceStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  titles Title[]

  @@index([companyId])
  @@map("recurrence_rules")
}

model Title {
  id                  String      @id @default(uuid())
  companyId           String      @map("company_id")
  company             Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  type                TitleType
  description         String
  categoryId          String      @map("category_id")
  category            Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  partyId             String?     @map("party_id")
  party               Party?      @relation(fields: [partyId], references: [id], onDelete: Restrict)
  originalAmountCents BigInt      @map("original_amount_cents")
  currency            String      @default("BRL")
  competenceDate      DateTime    @map("competence_date") @db.Date
  dueDate             DateTime    @map("due_date") @db.Date
  status              TitleStatus @default(OPEN)
  cancelReason        String?     @map("cancel_reason")
  notes               String?
  installmentGroupId  String?     @map("installment_group_id")
  installmentNumber   Int?        @map("installment_number")
  installmentCount    Int?        @map("installment_count")
  recurrenceRuleId         String?        @map("recurrence_rule_id")
  recurrenceRule           RecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id], onDelete: Restrict)
  recurrenceOccurrenceDate DateTime?      @map("recurrence_occurrence_date") @db.Date
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  settlements Settlement[]

  @@unique([recurrenceRuleId, recurrenceOccurrenceDate])
  @@index([companyId])
  @@index([companyId, dueDate])
  @@index([categoryId])
  @@index([partyId])
  @@index([companyId, installmentGroupId])
  @@index([companyId, recurrenceRuleId])
  @@map("titles")
}

model Settlement {
  id                   String    @id @default(uuid())
  companyId            String    @map("company_id")
  company              Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  titleId              String    @map("title_id")
  title                Title     @relation(fields: [titleId], references: [id], onDelete: Restrict)
  financialAccountId   String    @map("financial_account_id")
  financialAccount     FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  principalAmountCents BigInt    @map("principal_amount_cents")
  discountCents        BigInt    @default(0) @map("discount_cents")
  interestPenaltyCents BigInt    @default(0) @map("interest_penalty_cents")
  feesCents            BigInt    @default(0) @map("fees_cents")
  effectiveDate        DateTime  @map("effective_date") @db.Date
  paymentMethod        String?   @map("payment_method")
  notes                String?
  reversedAt           DateTime? @map("reversed_at")
  reversalReason       String?   @map("reversal_reason")
  createdAt            DateTime  @default(now()) @map("created_at")

  reconciledByLine BankStatementLine?

  @@index([companyId])
  @@index([titleId])
  @@map("settlements")
}

model Transfer {
  id             String    @id @default(uuid())
  companyId      String    @map("company_id")
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  fromAccountId  String    @map("from_account_id")
  fromAccount    FinancialAccount @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccountId    String    @map("to_account_id")
  toAccount      FinancialAccount @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  amountCents    BigInt    @map("amount_cents")
  feeCents       BigInt    @default(0) @map("fee_cents")
  transferDate   DateTime  @map("transfer_date") @db.Date
  description    String?
  reversedAt     DateTime? @map("reversed_at")
  reversalReason String?   @map("reversal_reason")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([companyId])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("transfers")
}

enum BankStatementLineStatus {
  PENDING
  RECONCILED
  IGNORED
}

model ImportBatch {
  id                 String   @id @default(uuid())
  companyId          String   @map("company_id")
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  financialAccountId String   @map("financial_account_id")
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  fileName           String   @map("file_name")
  rowCount           Int      @map("row_count")
  importedCount      Int      @map("imported_count")
  duplicateCount     Int      @map("duplicate_count")
  invalidCount       Int      @map("invalid_count")
  createdAt          DateTime @default(now()) @map("created_at")

  lines BankStatementLine[]

  @@index([companyId])
  @@map("import_batches")
}

model BankStatementLine {
  id                     String                  @id @default(uuid())
  companyId              String                  @map("company_id")
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  financialAccountId     String                  @map("financial_account_id")
  financialAccount       FinancialAccount        @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  importBatchId          String                  @map("import_batch_id")
  importBatch            ImportBatch             @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  lineDate               DateTime                @map("line_date") @db.Date
  description            String
  amountCents            BigInt                  @map("amount_cents")
  dedupKey               String                  @map("dedup_key")
  status                 BankStatementLineStatus @default(PENDING)
  reconciledSettlementId String?                 @unique @map("reconciled_settlement_id")
  reconciledSettlement   Settlement?             @relation(fields: [reconciledSettlementId], references: [id], onDelete: Restrict)
  ignoreReason           String?                 @map("ignore_reason")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@unique([companyId, financialAccountId, dedupKey])
  @@index([companyId])
  @@index([financialAccountId])
  @@map("bank_statement_lines")
}

model AuditEvent {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actorUserId  String   @map("actor_user_id")
  eventType    String   @map("event_type")
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  summary      String
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([companyId, resourceType, resourceId])
  @@index([companyId, createdAt])
  @@map("audit_events")
}

enum PeriodClosureStatus {
  CLOSED
  REOPENED
}

model PeriodClosure {
  id               String              @id @default(uuid())
  companyId        String              @map("company_id")
  company          Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  period           String
  status           PeriodClosureStatus @default(CLOSED)
  closedByUserId   String              @map("closed_by_user_id")
  closedAt         DateTime            @default(now()) @map("closed_at")
  reopenedByUserId String?             @map("reopened_by_user_id")
  reopenedAt       DateTime?           @map("reopened_at")
  reopenReason     String?             @map("reopen_reason")

  @@unique([companyId, period])
  @@map("period_closures")
}
