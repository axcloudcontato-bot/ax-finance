# Postgres local (instalado nativamente no Windows, sem Docker).
# Usado só por `prisma migrate`/`prisma studio` — é o dono das tabelas.
DATABASE_URL="postgresql://postgres:postgres_dev_only@localhost:5432/ax_finance_dev"

# Usado pela aplicação em runtime (apps/web, testes). Role de baixo
# privilégio criado pela migration de RLS — é o que de fato fica sujeito
# às políticas de isolamento por empresa (superusuário/dono ignora RLS).
APP_DATABASE_URL="postgresql://ax_app:OMe21B_Wkcck4aQcsck8NQ_3@localhost:5432/ax_finance_dev"

# Bancos usados pelos testes de integração (isolamento, saldo inicial, sessão)
TEST_DATABASE_URL="postgresql://postgres:postgres_dev_only@localhost:5432/ax_finance_test"
TEST_APP_DATABASE_URL="postgresql://ax_app:OMe21B_Wkcck4aQcsck8NQ_3@localhost:5432/ax_finance_test"

# Segredo para assinar o cookie de sessão. Gere um valor forte por ambiente:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque-este-valor-em-cada-ambiente"

# Chave exclusiva para cifrar segredos TOTP (64 caracteres hexadecimais).
# Se omitida, SESSION_SECRET é usado como fallback, mas produção deve separar as chaves.
MFA_ENCRYPTION_KEY="troque-por-64-caracteres-hexadecimais"

# Cifra os payloads da outbox, inclusive links temporários enviados por e-mail.
OUTBOX_ENCRYPTION_KEY="troque-por-outro-valor-de-64-caracteres-hexadecimais"

# URL pública usada nos links de verificação e recuperação.
APP_BASE_URL="http://localhost:3000"

# Em desenvolvimento, mostra o link transacional na própria tela quando não
# há SMTP. Nunca habilite preview em produção.
EMAIL_PREVIEW="true"

# SMTP transacional (opcional no desenvolvimento; obrigatório em produção).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="AX Finance <no-reply@example.com>"

# Worker assíncrono (valores padrão).
WORKER_POLL_INTERVAL_MS="5000"
WORKER_BATCH_SIZE="10"

# Diretório privado dos anexos (padrão local: .data/attachments).
ATTACHMENTS_DIR=""
