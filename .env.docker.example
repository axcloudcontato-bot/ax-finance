# Copie para `.env` (mesmo diretório do docker-compose.yml) antes de rodar
# `docker compose up`. O Compose lê esse `.env` automaticamente.

# Senha do superusuário do Postgres (dono das tabelas, usado só pelo job de
# migrations). Gere uma senha forte por ambiente.
POSTGRES_PASSWORD=troque-este-valor

# Senha do role de baixo privilégio `ax_app`, o que a aplicação usa em
# runtime. A migration `20260925015200_rls_and_app_role` cria esse role com a
# senha de desenvolvimento "OMe21B_Wkcck4aQcsck8NQ_3" caso ele ainda não
# exista — em produção, depois do primeiro `docker compose up`, troque-a:
#   docker compose exec postgres psql -U postgres -d ax_finance \
#     -c "ALTER ROLE ax_app WITH PASSWORD 'novo-valor-forte'"
# e atualize esta variável para o mesmo valor antes de reiniciar o `web`.
AX_APP_PASSWORD=OMe21B_Wkcck4aQcsck8NQ_3

# Segredo para assinar o cookie de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-este-valor

# Chave separada usada para cifrar os segredos dos autenticadores TOTP.
# Gere com o mesmo comando acima e mantenha estável entre os deploys.
MFA_ENCRYPTION_KEY=troque-este-valor

# Chave separada para cifrar payloads pendentes da outbox.
OUTBOX_ENCRYPTION_KEY=troque-este-valor

# URL pública e SMTP para confirmação de e-mail/recuperação de senha.
APP_BASE_URL=https://financeiro.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-smtp
SMTP_PASSWORD=troque-este-valor
SMTP_FROM="AX Finance <no-reply@example.com>"

WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=10
IMPORT_WORKER_BATCH_SIZE=2

# Tokens separados para coleta Prometheus e diagnóstico operacional. Use no
# mínimo 24 caracteres aleatórios; as rotas exigem Authorization: Bearer.
METRICS_TOKEN=troque-por-token-aleatorio-longo
OPERATIONS_TOKEN=troque-por-outro-token-aleatorio-longo

# Backup diário local. Em produção, prefira um caminho em disco separado e
# replique esse diretório para armazenamento externo cifrado.
BACKUP_HOST_DIR=./.backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_AGE_SECONDS=129600

# Observabilidade e alertas. ALERT_WEBHOOK_URL é opcional; sem ele, alertas
# continuam aparecendo como JSON nos logs do worker.
DEPLOY_ENVIRONMENT=production
MONITOR_INTERVAL_MS=60000
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MINUTES=30
ALERT_OUTBOX_PENDING_SECONDS=900
ALERT_IMPORT_PENDING_SECONDS=1800
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Retenção automática apenas de artefatos operacionais. Registros financeiros,
# auditoria e anexos não são removidos por essa rotina.
RETENTION_PROCESSED_OUTBOX_DAYS=30
RETENTION_DEAD_LETTER_DAYS=90
RETENTION_IDENTITY_ARTIFACT_DAYS=30
RETENTION_COMPLETED_IMPORT_JOB_DAYS=30
RETENTION_FAILED_IMPORT_JOB_DAYS=90

# O compose usa /data/attachments em um volume Docker persistente.
ATTACHMENTS_DIR=/data/attachments
IMPORTS_DIR=/data/imports
