# Postgres local (instalado nativamente no Windows, sem Docker).
# Usado só por `prisma migrate`/`prisma studio` — é o dono das tabelas.
DATABASE_URL="postgresql://postgres:postgres_dev_only@localhost:5432/ax_finance_dev"

# Usado pela aplicação em runtime (apps/web, testes). Role de baixo
# privilégio criado pela migration de RLS — é o que de fato fica sujeito
# às políticas de isolamento por empresa (superusuário/dono ignora RLS).
APP_DATABASE_URL="postgresql://ax_app:OMe21B_Wkcck4aQcsck8NQ_3@localhost:5432/ax_finance_dev"

# Bancos usados pelos testes de integração (isolamento, saldo inicial, sessão)
TEST_DATABASE_URL="postgresql://postgres:postgres_dev_only@localhost:5432/ax_finance_test"
TEST_APP_DATABASE_URL="postgresql://ax_app:OMe21B_Wkcck4aQcsck8NQ_3@localhost:5432/ax_finance_test"

# Segredo para assinar o cookie de sessão. Gere um valor forte por ambiente:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque-este-valor-em-cada-ambiente"

# Chave exclusiva para cifrar segredos TOTP (64 caracteres hexadecimais).
# Se omitida, SESSION_SECRET é usado como fallback, mas produção deve separar as chaves.
MFA_ENCRYPTION_KEY="troque-por-64-caracteres-hexadecimais"

# Cifra os payloads da outbox, inclusive links temporários enviados por e-mail.
OUTBOX_ENCRYPTION_KEY="troque-por-outro-valor-de-64-caracteres-hexadecimais"

# URL pública usada nos links de verificação e recuperação.
APP_BASE_URL="http://localhost:3000"

# Em desenvolvimento, mostra o link transacional na própria tela quando não
# há SMTP. Nunca habilite preview em produção.
EMAIL_PREVIEW="true"

# SMTP transacional (opcional no desenvolvimento; obrigatório em produção).
# Alternativa: Admin > E-mail no painel; salvo e ligado lá, tem prioridade sobre estas variáveis.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="AX Finance <no-reply@example.com>"

# Worker assíncrono (valores padrão).
WORKER_POLL_INTERVAL_MS="5000"
WORKER_BATCH_SIZE="10"
IMPORT_WORKER_BATCH_SIZE="2"

# Observabilidade local (opcional). As rotas ficam indisponíveis sem tokens
# de pelo menos 24 caracteres.
METRICS_TOKEN=""
OPERATIONS_TOKEN=""
MONITOR_INTERVAL_MS="60000"
ALERT_WEBHOOK_URL=""
ALERT_COOLDOWN_MINUTES="30"
ALERT_OUTBOX_PENDING_SECONDS="900"
ALERT_IMPORT_PENDING_SECONDS="1800"
BACKUP_STATUS_FILE=""
WORKER_HEALTH_FILE=""

# Coletor externo Prometheus Remote Write (perfil Compose `monitoring`).
PROMETHEUS_REMOTE_WRITE_URL=""
PROMETHEUS_REMOTE_WRITE_USERNAME=""
PROMETHEUS_REMOTE_WRITE_PASSWORD=""
DEPLOY_ENVIRONMENT="production"

# Cópia externa imutável dos backups com rclone (perfil `external-backup`).
# Exemplo: s3:ax-finance-backups/production
BACKUP_HOST_DIR="./.backups"
BACKUP_REMOTE=""
RCLONE_CONFIG_HOST_PATH="./.secrets/rclone.conf"
BACKUP_COPY_INTERVAL_HOURS="24"
BACKUP_COPY_MAX_AGE_SECONDS="129600"

# Retenção dos artefatos operacionais efêmeros.
RETENTION_PROCESSED_OUTBOX_DAYS="30"
RETENTION_DEAD_LETTER_DAYS="90"
RETENTION_IDENTITY_ARTIFACT_DAYS="30"
RETENTION_COMPLETED_IMPORT_JOB_DAYS="30"
RETENTION_FAILED_IMPORT_JOB_DAYS="90"

# Diretório privado dos anexos (padrão local: .data/attachments).
ATTACHMENTS_DIR=""

# Arquivos bancários temporários usados entre a prévia e o processamento.
IMPORTS_DIR=""

# Use `s3` em instalações com múltiplas instâncias web. Quando a verificação
# for obrigatória, uploads falham de forma segura se o clamd estiver fora.
ATTACHMENT_STORAGE_BACKEND="local"
ATTACHMENT_SCAN_REQUIRED="false"
CLAMAV_HOST=""
CLAMAV_PORT="3310"
CLAMD_STARTUP_TIMEOUT="1800"
FRESHCLAM_CHECKS="12"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Cobrança da assinatura via Stripe (opcional; ver docs/stripe-billing.md).
# Use chaves de TESTE (sk_test_…) fora de produção. Nunca versione valores reais.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PERSONAL=
STRIPE_PRICE_ESSENTIAL=
